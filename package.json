{
  "name": "baristaflow",
  "version": "1.0.9",
  "productName": "Baristaflow",
  "description": "BaristaFlow POS – Electron Desktop App",
  "main": "electron/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-production": "electron-builder --win --x64",
    "publish": "electron-builder --win --x64 --publish always",
    "lint": "eslint electron --ext .js,.ts"
  },
  "author": "BaristaFlow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BaristaFlow/Desktop.git"
  },
  "build": {
    "appId": "com.baristaflow.pos",
    "productName": "Baristaflow",
    "directories": {
      "output": "production-exe"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerHeaderIcon": "assets/logo.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "BaristaFlow",
      "repo": "Desktop"
    }
  },
  "devDependencies": {
    "electron": "23.1.4",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.7.3"
  },
  "optionalDependencies": {
    "@thiagoelg/node-printer": "0.6.2",
    "electron-pos-msh-printer": "^1.0.2"
  }
}
